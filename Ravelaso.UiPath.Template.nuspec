<?xml version="1.0"?>
<package>
  <metadata>
    <id>Ravelaso.UiPath.Template</id>
    <version>2.1.0</version>
    <authors>Andres Ravelo (@ravelaso)</authors>
    <owners>Andres Ravelo</owners>
    <projectUrl>https://github.com/ravelaso/UiPath.Activities.Template</projectUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>A multi-project template for UiPath activities ported from original VisualStudio template.</description>
    <tags>template;uipath;multi-project</tags>
    <readme>docs\README.md</readme>
    <icon>images\UI_icon.png</icon>
    <license type="file">docs\LICENSE.md</license>
  </metadata>
  <files>
    <file src="templates\**\*" target="content" />
    <file src="UI_icon.png" target="images\" />
    <file src="LICENSE.md" target="docs\" />
    <file src="README.md" target="docs\" />
  </files>
</package>