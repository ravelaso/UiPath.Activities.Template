{
  "$schema": "http://json.schemastore.org/template",
  "author": "Andres Ravelo",
  "classifications": ["UiPath", "Custom Activity", "Project"],
  "identity": "Ravelaso.UiPath.Activity",
  "name": "Ravelaso UiPath Activity Project",
  "shortName": "ravelaso-uipath-activity",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "ProjectName",
  "preferNameDirectory": false,
  "symbols": {
    "TargetFramework": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "net6.0",
          "description": "Target .NET 6.0"
        },
        {
          "choice": "net8.0",
          "description": "Target .NET 8.0"
        }
      ],
      "replaces": "FameworkParameter",
      "defaultValue": "net6.0",
      "description": "The target framework for the project."
    },
    "Examples": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include example code in the generated project."
    }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "condition": "Examples == 'false'",
      "exclude": [
        "examples"
      ],
      "include": [
        "Activity.cs",
      ]
    },
    {
      "source": "./examples",
      "target": "./",
      "condition": "Examples == 'true'",
      "include": [
        "*"
      ]
    },
    {
      "source": "./Helpers",
      "target": "./Helpers",
      "include": [
        "**/*"
      ]
    },
    {
      "source": "./",
      "target": "./",
      "include": [
        "ProjectName.csproj"
      ],
      "exclude": [
        "examples"
      ]
    }
  ]
}