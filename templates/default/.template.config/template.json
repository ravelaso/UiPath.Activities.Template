{
  "$schema": "http://json.schemastore.org/template",
  "author": "Andres Ravelo",
  "classifications": ["UiPath", "Custom Activity", "Solution"],
  "identity": "Ravelaso.UiPath.Default",
  "name": "Ravelaso UiPath Default Template",
  "shortName": "ravelaso-uipath",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "ProjectName",
  "preferNameDirectory": true,
  "symbols": {
    "ProjectName": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "ProjectName"
    },
    "TargetFramework": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "net6.0",
          "description": "Target .NET 6.0"
        },
        {
          "choice": "net8.0",
          "description": "Target .NET 8.0"
        }
      ],
      "replaces": "FameworkParameter",
      "defaultValue": "net6.0",
      "description": "The target framework for the project."
    }
  }
}
